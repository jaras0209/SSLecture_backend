# ─────────────────────────────────────────────────────────────────────────────
# 正式環境（prod profile）需要的環境變數。本地開發（dev profile）都有預設值，不必設定。
# 這個檔案只是清單，Spring Boot 不會自動讀取 .env；請在部署平台或 shell 設定這些變數。
# 請勿把填入真實值的檔案提交到 Git。
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

# MySQL 8.4（字元集、定序由 Liquibase 的第一個 changeset 設定；連線時區等設定在 application.yml）
DB_URL=jdbc:mysql://localhost:3306/sslecture
DB_USERNAME=
DB_PASSWORD=

# Redis（社群登入的一次性 code）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 簽名金鑰（Base64，至少 256 bit）：openssl rand -base64 32
JWT_SECRET=

# 前端
FRONTEND_URL=https://jaras0209.github.io/SSLecture_front_end
CORS_ALLOWED_ORIGINS=https://jaras0209.github.io

# Google OAuth 2.0（Google Cloud Console）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login（LINE Developers Console）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
